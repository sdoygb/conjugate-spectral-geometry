#!/usr/bin/expect -f
set timeout 2400
set pass [lindex $argv 0]
set gai [lindex $argv 1]
set sf [lindex $argv 2]
set api2d [lindex $argv 3]
set kimi [lindex $argv 4]
spawn ssh -t -o StrictHostKeyChecking=accept-new sdoygb@192.168.1.88 "cd /tmp/GeometryAI-Linux-SubAI-v1.0.0.0812 && sudo bash setup.sh"
expect {
    -re "s password:" { send "$pass\r"; exp_continue }
    -re "authenticate" { send "$pass\r"; exp_continue }
    -re "password for sdoygb" { send "$pass\r"; exp_continue }
    -re "DeepSeek API Key" { send "$gai\r"; exp_continue }
    -re "SiliconFlow API Key" { send "$sf\r"; exp_continue }
    -re "主库AI地址" { send "\r"; exp_continue }
    -re "API2D Key" { send "$api2d\r"; exp_continue }
    -re "Moonshot Key" { send "$kimi\r"; exp_continue }
    -re "Permission denied" { puts "AUTH_FAILED"; exit 1 }
    eof
}
