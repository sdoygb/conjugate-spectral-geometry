#!/usr/bin/expect -f
set timeout 60
set pass [lindex $argv 0]
set cmd [lindex $argv 1]
spawn ssh -o StrictHostKeyChecking=accept-new sdoygb@192.168.1.88 $cmd
expect {
    "password:" { send "$pass\r"; exp_continue }
    "yes/no" { send "yes\r"; exp_continue }
    "Permission denied" { puts "AUTH_FAILED"; exit 1 }
    eof
}
